{
  "name": "mapbox-data-atlas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "An independent gallery of data visualization examples built with Mapbox GL JS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "data": "node scripts/prepare-data.mjs",
    "thumbs": "node scripts/capture-thumbs.mjs",
    "prompts": "node scripts/generate-prompts.mjs",
    "verify": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@turf/along": "^7.2.0",
    "@turf/bbox": "^7.2.0",
    "@turf/helpers": "^7.2.0",
    "@turf/length": "^7.2.0",
    "d3": "^7.9.0",
    "h3-js": "^4.2.1",
    "mapbox-gl": "3.33.0",
    "prismjs": "^1.30.0",
    "simple-statistics": "^7.8.8",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@turf/area": "^7.4.0",
    "@turf/simplify": "^7.4.0",
    "@types/d3": "^7.4.3",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.5",
    "@types/topojson-client": "^3.1.5",
    "typescript": "^5.9.2",
    "us-atlas": "^3.0.1",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
